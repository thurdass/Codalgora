{
  "schemaVersion": 1,
  "title": "Contador visual — Codalgora",
  "width": 420,
  "height": 360,
  "layout": "VERTICAL",
  "spacing": 16,
  "padding": 24,
  "algorithmPath": "contador.alg",
  "elements": [
    {
      "id": "titulo", "type": "LABEL", "name": "titulo", "text": "Meu primeiro contador",
